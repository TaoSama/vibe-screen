{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/stylus.schema.json",
  "title": "Vibe Screen physical stylus drawing-app evidence summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "profile",
    "verdict",
    "can_close_physical_stylus_gate",
    "requires_physical_stylus",
    "synthetic_adb_stylus_is_not_physical_stylus_evidence",
    "required_device_identity",
    "collector_status",
    "observations",
    "missing_requirements",
    "inconsistent_observations",
    "blocking_reasons",
    "artifact_paths",
    "blocking_notes",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "kind": {"const": "physical_stylus_drawing_app"},
    "profile": {"const": "physical-stylus-drawing-app"},
    "verdict": {"enum": ["pass", "blocked", "insufficient"]},
    "can_close_physical_stylus_gate": {"type": "boolean"},
    "requires_physical_stylus": {"const": true},
    "synthetic_adb_stylus_is_not_physical_stylus_evidence": {"const": true},
    "required_device_identity": {"type": "string", "minLength": 1},
    "collector_status": {"type": "string", "minLength": 1},
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adb_was_run",
        "device_identity_recorded",
        "device_identity_matches_claim",
        "pass_eligible_stylus_capability",
        "physical_drawing_observed",
        "android_stylus_forwarding_observed",
        "host_stylus_injection_observed",
        "host_stable_signed_tcc_ready",
        "visible_drawing_result_observed",
        "android_diag_log_retained",
        "host_log_window_retained",
        "collector_reported_passed"
      ],
      "properties": {
        "adb_was_run": {"type": "boolean"},
        "device_identity_recorded": {"type": "boolean"},
        "device_identity_matches_claim": {"type": "boolean"},
        "pass_eligible_stylus_capability": {"type": "boolean"},
        "physical_drawing_observed": {"type": "boolean"},
        "android_stylus_forwarding_observed": {"type": "boolean"},
        "host_stylus_injection_observed": {"type": "boolean"},
        "host_stable_signed_tcc_ready": {"type": "boolean"},
        "visible_drawing_result_observed": {"type": "boolean"},
        "android_diag_log_retained": {"type": "boolean"},
        "host_log_window_retained": {"type": "boolean"},
        "collector_reported_passed": {"type": "boolean"}
      }
    },
    "missing_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "requirement"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1}
        }
      }
    },
    "inconsistent_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "requires", "requirement"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "requires": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "requirement": {"type": "string", "minLength": 1}
        }
      }
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "requirement"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blocking_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string"}
  }
}
