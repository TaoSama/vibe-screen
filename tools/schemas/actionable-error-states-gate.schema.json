{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/actionable-error-states-gate.schema.json",
  "title": "Vibe Screen Phase 1 actionable-error state gate summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "verdict",
    "can_close_readme_phase1_actionable_errors_gate",
    "matrix_kind",
    "owner",
    "state_count",
    "android_state_count",
    "macos_host_state_count",
    "reviewed_open_prs",
    "required_actionable_state_ids",
    "covered_actionable_state_ids",
    "missing_actionable_state_ids",
    "required_actionable_contract_codes",
    "covered_actionable_contract_codes",
    "missing_actionable_contract_codes",
    "covered_android_session_failure_kinds",
    "missing_android_session_failure_kinds",
    "unknown_android_session_failure_kinds",
    "errors",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "kind": {"const": "phase1_actionable_error_state_gate"},
    "verdict": {"enum": ["pass", "fail"]},
    "can_close_readme_phase1_actionable_errors_gate": {"const": false},
    "matrix_kind": {"type": "string"},
    "owner": {"type": "string"},
    "state_count": {"type": "integer", "minimum": 0},
    "android_state_count": {"type": "integer", "minimum": 0},
    "macos_host_state_count": {"type": "integer", "minimum": 0},
    "reviewed_open_prs": {"type": "array", "items": {"type": "integer"}},
    "required_actionable_state_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "covered_actionable_state_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_actionable_state_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_actionable_contract_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "covered_actionable_contract_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_actionable_contract_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "covered_android_session_failure_kinds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_android_session_failure_kinds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unknown_android_session_failure_kinds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interpretation": {"type": "string", "minLength": 1}
  }
}
