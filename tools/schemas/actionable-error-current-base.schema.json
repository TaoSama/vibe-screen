{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/actionable-error-current-base.schema.json",
  "title": "Vibe Screen Phase 1 actionable-error current-base evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "created_at",
    "evidence_boundary",
    "can_close_readme_phase1_actionable_errors_gate",
    "repository",
    "device",
    "states",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "vibescreen.evidence/v1" },
    "kind": { "const": "phase1_actionable_error_current_base" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "evidence_boundary": { "type": "string", "minLength": 1 },
    "can_close_readme_phase1_actionable_errors_gate": { "type": "boolean" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "branch", "collected_at_commit", "evaluated_at_commit", "baseline", "notes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "collected_at_commit": { "type": "string", "minLength": 1 },
        "evaluated_at_commit": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "minLength": 1 },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adb_serial", "manufacturer", "model", "codename", "android_release", "sdk"],
      "properties": {
        "adb_serial": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "codename": { "type": "string", "minLength": 1 },
        "android_release": { "type": "string", "minLength": 1 },
        "sdk": { "type": "string", "minLength": 1 }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "classification",
          "owner",
          "observed_on_device",
          "can_close_state",
          "closure_requirements",
          "blockers",
          "notes",
          "artifacts"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "blocked", "insufficient", "not_run"] },
          "classification": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "observed_on_device": { "type": "boolean" },
          "can_close_state": { "type": "boolean" },
          "closure_requirements": { "type": "array", "items": { "type": "string" } },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "kind", "description"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "minLength": 64 },
                "kind": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
