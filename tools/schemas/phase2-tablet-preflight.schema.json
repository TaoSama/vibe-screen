{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/phase2-tablet-preflight.schema.json",
  "title": "Vibe Screen Phase 2 tablet acceptance preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "generated_at",
    "evidence_dir",
    "device_class",
    "verdict",
    "gates",
    "reasons",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "kind": {"const": "phase2_tablet_acceptance_preflight"},
    "generated_at": {"type": "string", "format": "date-time"},
    "evidence_dir": {"type": "string", "minLength": 1},
    "device_class": {"type": ["string", "null"]},
    "verdict": {"enum": ["pass", "blocked", "fail", "insufficient"]},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence", "reasons"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "blocked", "fail", "insufficient", "missing"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interpretation": {"type": "string", "minLength": 1}
  }
}
