{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/host-display-rotation-gate.schema.json",
  "title": "Vibe Screen host display rotation gate result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "covered_display_kinds",
    "required_display_kinds",
    "required_transports",
    "required_device_fields",
    "required_host_preflight_fields",
    "required_probes",
    "required_artifacts",
    "artifact_file_check",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "kind": {"const": "host_display_rotation_acceptance"},
    "status": {"enum": ["complete", "failed"]},
    "covered_display_kinds": {
      "type": "array",
      "items": {"enum": ["physical", "virtual"]}
    },
    "required_display_kinds": {
      "type": "array",
      "items": {"enum": ["physical", "virtual"]},
      "const": ["physical", "virtual"]
    },
    "required_transports": {
      "type": "array",
      "items": {"enum": ["lan", "usb"]},
      "const": ["lan", "usb"]
    },
    "required_device_fields": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "const": [
        "manufacturer",
        "model",
        "codename",
        "android_release",
        "sdk",
        "adb_serial"
      ]
    },
    "required_host_preflight_fields": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "const": [
        "host_signing_identity",
        "host_bundle_id",
        "screen_recording_granted",
        "accessibility_granted",
        "signing_tcc_match",
        "host_display_rotation_restoration_plan"
      ]
    },
    "required_probes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "const": [
        "visual_source_orientation",
        "input_mapping",
        "stable_stream",
        "no_session_teardown",
        "restored_original_host_rotation"
      ]
    },
    "required_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "const": [
        "device_identity",
        "host_display_snapshot_before",
        "host_display_snapshot_rotated",
        "android_screenshot",
        "touch_matrix",
        "host_log",
        "android_logcat"
      ]
    },
    "artifact_file_check": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
