{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/manifest.schema.json",
  "title": "Vibe Screen evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "kind", "created_at", "command", "repository", "host"],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "kind": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty", "status_porcelain"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"},
        "status_porcelain": {"type": "array", "items": {"type": "string"}}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "python", "machine"],
      "properties": {
        "platform": {"type": "string"},
        "python": {"type": "string"},
        "machine": {"type": "string"}
      }
    },
    "device": {"type": "object"},
    "measurement": {"type": "object"}
  }
}

