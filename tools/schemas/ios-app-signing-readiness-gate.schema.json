{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/ios-app-signing-readiness-gate.schema.json",
  "title": "Vibe Screen iOS app-signing readiness gate result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "owner",
    "source",
    "current_base",
    "verdict",
    "signing_status",
    "signing_summary",
    "readiness_requirements",
    "can_close_ios_app_signing_readiness",
    "can_close_ios_device_acceptance",
    "recorded_fields",
    "missing",
    "failures",
    "evidence",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "kind": {"const": "ios_app_signing_readiness_gate"},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "head_ref", "repository", "scope"],
      "properties": {
        "role": {"const": "ios_app_signing_readiness_current_base_owner"},
        "head_ref": {"const": "codex/ios-app-signing-readiness-current-base-20260829"},
        "repository": {"const": "TaoSama/vibe-screen"},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "evidence_root"],
      "properties": {
        "readiness": {"type": ["string", "null"]},
        "evidence_root": {"type": "string", "minLength": 1}
      }
    },
    "current_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "branch", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "branch": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "verdict": {"enum": ["pass", "blocked", "fail"]},
    "signing_status": {"type": ["string", "null"]},
    "signing_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "bundle_id",
        "unique_bundle_id",
        "team_id_recorded",
        "codesign_identity_recorded",
        "provisioning_profile_recorded",
        "device_udid_hashes_recorded",
        "entitlements_recorded",
        "signed_artifact_sha256"
      ],
      "properties": {
        "status": {"enum": ["pass", "blocked", "fail"]},
        "bundle_id": {"type": ["string", "null"]},
        "unique_bundle_id": {"type": "boolean"},
        "team_id_recorded": {"type": "boolean"},
        "codesign_identity_recorded": {"type": "boolean"},
        "provisioning_profile_recorded": {"type": "boolean"},
        "device_udid_hashes_recorded": {"type": "boolean"},
        "entitlements_recorded": {"type": "boolean"},
        "signed_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "readiness_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requirements",
        "labels",
        "all_requirements_recorded",
        "simulator_build_used",
        "unsigned_build_used",
        "android_evidence_used"
      ],
      "properties": {
        "status": {"enum": ["pass", "blocked", "fail"]},
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "team_id",
            "provisioning_profile",
            "bundle_id",
            "codesign_identity",
            "device_udids",
            "entitlements"
          ],
          "properties": {
            "team_id": {"type": "boolean"},
            "provisioning_profile": {"type": "boolean"},
            "bundle_id": {"type": "boolean"},
            "codesign_identity": {"type": "boolean"},
            "device_udids": {"type": "boolean"},
            "entitlements": {"type": "boolean"}
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "team_id",
            "provisioning_profile",
            "bundle_id",
            "codesign_identity",
            "device_udids",
            "entitlements"
          ],
          "properties": {
            "team_id": {"type": "string", "minLength": 1},
            "provisioning_profile": {"type": "string", "minLength": 1},
            "bundle_id": {"type": "string", "minLength": 1},
            "codesign_identity": {"type": "string", "minLength": 1},
            "device_udids": {"type": "string", "minLength": 1},
            "entitlements": {"type": "string", "minLength": 1}
          }
        },
        "all_requirements_recorded": {"type": "boolean"},
        "simulator_build_used": {"const": false},
        "unsigned_build_used": {"const": false},
        "android_evidence_used": {"const": false}
      }
    },
    "can_close_ios_app_signing_readiness": {"type": "boolean"},
    "can_close_ios_device_acceptance": {"const": false},
    "recorded_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_id",
        "provisioning_profile",
        "bundle_id",
        "codesign_identity",
        "device_udid",
        "entitlements",
        "signed_artifact",
        "artifacts"
      ],
      "properties": {
        "team_id": {"type": "boolean"},
        "provisioning_profile": {"type": "boolean"},
        "bundle_id": {"type": "boolean"},
        "codesign_identity": {"type": "boolean"},
        "device_udid": {"type": "boolean"},
        "entitlements": {"type": "boolean"},
        "signed_artifact": {"type": "boolean"},
        "artifacts": {"type": "boolean"}
      }
    },
    "missing": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interpretation": {"type": "string", "minLength": 1}
  }
}
