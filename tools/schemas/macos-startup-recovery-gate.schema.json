{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/macos-startup-recovery-gate.schema.json",
  "title": "Vibe Screen macOS startup and headless recovery gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "derivation_status",
    "verdict",
    "can_close_login_headless_gate",
    "can_claim_headless_mac_mini_operation",
    "source_evidence",
    "required_boundaries",
    "checks",
    "open_reasons",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "kind": {"const": "macos_startup_recovery_gate"},
    "derivation_status": {"const": "complete"},
    "verdict": {"enum": ["pass", "blocked", "fail", "insufficient"]},
    "can_close_login_headless_gate": {"type": "boolean"},
    "can_claim_headless_mac_mini_operation": {"type": "boolean"},
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "run_id", "source_commit"],
      "properties": {
        "kind": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"]},
        "source_commit": {"type": ["string", "null"]}
      }
    },
    "required_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "array",
      "minItems": 7,
      "items": {"$ref": "#/$defs/check"}
    },
    "open_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "passed", "evidence", "reasons"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "blocked", "fail", "insufficient"]},
        "passed": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
