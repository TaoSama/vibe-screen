{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/phase3-adaptive-media-current-base.schema.json",
  "title": "Vibe Screen Phase 3 adaptive-media current-base gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "created_at",
    "verdict",
    "gate_can_close_phase3_release",
    "can_claim_current_base_adaptive_media_fluctuation",
    "owner",
    "current_base",
    "device",
    "source",
    "checks",
    "adaptive_media_summary",
    "transport_summary",
    "reasons",
    "release_gate_effect",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "kind": {"const": "phase3_adaptive_media_current_base_gate"},
    "created_at": {"type": "string", "format": "date-time", "minLength": 1},
    "verdict": {"enum": ["pass", "fail", "blocked"]},
    "gate_can_close_phase3_release": {"const": false},
    "can_claim_current_base_adaptive_media_fluctuation": {"type": "boolean"},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "head_ref", "repository", "scope"],
      "properties": {
        "role": {"const": "phase3_adaptive_media_current_base_owner"},
        "head_ref": {"type": "string", "minLength": 1},
        "repository": {"const": "TaoSama/vibe-screen"},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "current_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit", "report_repository_revision", "report_repository_dirty"],
      "properties": {
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "report_repository_revision": {"type": ["string", "null"]},
        "report_repository_dirty": {"type": ["boolean", "null"]}
      }
    },
    "device": {"type": ["object", "null"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report",
        "report_repository_revision",
        "report_repository_branch",
        "report_repository_dirty",
        "raw_sources"
      ],
      "properties": {
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "exists"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "exists": {"type": "boolean"}
          }
        },
        "report_repository_revision": {"type": ["string", "null"]},
        "report_repository_branch": {"type": ["string", "null"]},
        "report_repository_dirty": {"type": ["boolean", "null"]},
        "raw_sources": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_schema",
        "report_passed",
        "current_base_commit",
        "clean_source",
        "android_device_identity",
        "public_internet_scope",
        "controlled_real_impairment",
        "impairment_tool",
        "no_static_fixture_or_synthetic_media",
        "real_webrtc_statistics",
        "raw_sources_retained",
        "fast_drop",
        "slow_rise",
        "bitrate_fps_profile_changes",
        "config_epoch_progression",
        "config_ack_keyframe_resume",
        "policy_safety_boundaries",
        "no_unsafe_oscillation",
        "transport_continuity"
      ],
      "properties": {
        "report_schema": {"$ref": "#/$defs/check"},
        "report_passed": {"$ref": "#/$defs/check"},
        "current_base_commit": {"$ref": "#/$defs/check"},
        "clean_source": {"$ref": "#/$defs/check"},
        "android_device_identity": {"$ref": "#/$defs/check"},
        "public_internet_scope": {"$ref": "#/$defs/check"},
        "controlled_real_impairment": {"$ref": "#/$defs/check"},
        "impairment_tool": {"$ref": "#/$defs/check"},
        "no_static_fixture_or_synthetic_media": {"$ref": "#/$defs/check"},
        "real_webrtc_statistics": {"$ref": "#/$defs/check"},
        "raw_sources_retained": {"$ref": "#/$defs/check"},
        "fast_drop": {"$ref": "#/$defs/check"},
        "slow_rise": {"$ref": "#/$defs/check"},
        "bitrate_fps_profile_changes": {"$ref": "#/$defs/check"},
        "config_epoch_progression": {"$ref": "#/$defs/check"},
        "config_ack_keyframe_resume": {"$ref": "#/$defs/check"},
        "policy_safety_boundaries": {"$ref": "#/$defs/check"},
        "no_unsafe_oscillation": {"$ref": "#/$defs/check"},
        "transport_continuity": {"$ref": "#/$defs/check"}
      }
    },
    "adaptive_media_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downgrade_within_observations",
        "upgrade_after_observations",
        "config_epochs",
        "profile_event_count"
      ],
      "properties": {
        "downgrade_within_observations": {"type": ["number", "null"]},
        "upgrade_after_observations": {"type": ["number", "null"]},
        "config_epochs": {"type": "array", "items": {"type": "integer"}},
        "profile_event_count": {"type": "integer", "minimum": 0}
      }
    },
    "transport_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_transport",
        "selected_candidate_pair",
        "transport_restart_count",
        "session_epoch_unchanged",
        "media_channel_continuous"
      ],
      "properties": {
        "selected_transport": {"type": ["string", "null"]},
        "selected_candidate_pair": {"type": ["string", "null"]},
        "transport_restart_count": {"type": ["integer", "null"], "minimum": 0},
        "session_epoch_unchanged": {"type": ["boolean", "null"]},
        "media_channel_continuous": {"type": ["boolean", "null"]}
      }
    },
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "release_gate_effect": {"enum": ["none", "child_gate_only"]},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "pass"}}, "required": ["verdict"]},
      "then": {
        "properties": {
          "can_claim_current_base_adaptive_media_fluctuation": {"const": true},
          "release_gate_effect": {"const": "child_gate_only"}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"enum": ["blocked", "fail"]}}, "required": ["verdict"]},
      "then": {
        "properties": {
          "can_claim_current_base_adaptive_media_fluctuation": {"const": false},
          "release_gate_effect": {"const": "none"}
        }
      }
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "expected", "evidence"],
      "properties": {
        "passed": {"type": "boolean"},
        "expected": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
