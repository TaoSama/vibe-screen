{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/ios-current-base-gate.schema.json",
  "title": "Vibe Screen iOS current-base readiness gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "derivation_status",
    "verdict",
    "run_id",
    "owner",
    "gate_owners",
    "source",
    "can_close_ios_device_acceptance",
    "can_close_current_base_aggregate",
    "can_claim_device_pass",
    "checks",
    "reasons",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "kind": {"const": "ios_current_base_readiness_gate"},
    "derivation_status": {"enum": ["complete", "failed"]},
    "verdict": {"enum": ["pass", "blocked", "insufficient", "fail"]},
    "run_id": {"type": ["string", "null"]},
    "owner": {"type": ["object", "null"]},
    "gate_owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signing",
        "device_install",
        "protocol_session",
        "videotoolbox_h264",
        "videotoolbox_hevc",
        "input",
        "reconnect",
        "audio_playback",
        "hdr_output",
        "advanced_adapters",
        "host_advanced_adapters",
        "trusted_lan_secure_records"
      ],
      "properties": {
        "signing": {"const": "#182"},
        "device_install": {"const": "#182"},
        "protocol_session": {"const": "#182"},
        "videotoolbox_h264": {"const": "#251"},
        "videotoolbox_hevc": {"const": "#251"},
        "input": {"const": "#257"},
        "reconnect": {"const": "#238"},
        "audio_playback": {"const": "#209"},
        "hdr_output": {"const": "#196"},
        "advanced_adapters": {"const": "#253"},
        "host_advanced_adapters": {"const": "#253"},
        "trusted_lan_secure_records": {"const": "#208"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {"manifest": {"type": "string", "minLength": 1}}
    },
    "can_close_ios_device_acceptance": {"type": "boolean"},
    "can_close_current_base_aggregate": {"type": "boolean"},
    "can_claim_device_pass": {"type": "boolean"},
    "checks": {"type": "object"},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interpretation": {"type": "string", "minLength": 1}
  }
}
