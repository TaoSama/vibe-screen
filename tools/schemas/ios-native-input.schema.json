{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/ios-native-input.schema.json",
  "title": "Vibe Screen Phase 5 iOS native-input behavior evidence summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "profile",
    "gate_owner",
    "owner",
    "current_base",
    "verdict",
    "can_close_ios_native_input_gate",
    "requires_real_ios_device",
    "requires_signed_app",
    "requires_physical_keyboard",
    "requires_hover_or_pointer_accessory",
    "android_evidence_is_not_ios_input_evidence",
    "simulator_is_not_ios_input_evidence",
    "offline_tests_are_readiness_only",
    "observations",
    "missing_requirements",
    "blocking_reasons",
    "disallowed_evidence",
    "artifact_paths",
    "blocking_notes",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "kind": {"const": "ios_native_input_behavior"},
    "profile": {"const": "ios-native-input-behavior"},
    "gate_owner": {"const": "phase5-ios-native-input-behavior"},
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "head_ref", "pull_request", "repository", "scope"],
      "properties": {
        "role": {"const": "ios_native_input_behavior_current_base_owner"},
        "head_ref": {"const": "codex/ios-native-input-readiness-gate"},
        "pull_request": {"const": "#257"},
        "repository": {"const": "TaoSama/vibe-screen"},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "current_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "verdict": {"enum": ["pass", "blocked", "insufficient", "fail"]},
    "can_close_ios_native_input_gate": {"type": "boolean"},
    "requires_real_ios_device": {"const": true},
    "requires_signed_app": {"const": true},
    "requires_physical_keyboard": {"const": true},
    "requires_hover_or_pointer_accessory": {"const": true},
    "android_evidence_is_not_ios_input_evidence": {"const": true},
    "simulator_is_not_ios_input_evidence": {"const": true},
    "offline_tests_are_readiness_only": {"const": true},
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ios_device_lock_acquired",
        "device_identity_recorded",
        "device_is_iphone_or_ipad",
        "iphone_native_input_observed",
        "ipad_native_input_observed",
        "app_revision_recorded",
        "signed_app_installed",
        "local_network_permission_recorded",
        "baseline_machost_listener_observed",
        "protocol_session_negotiated",
        "input_capabilities_negotiated",
        "display_stream_binding_recorded",
        "touch_tap_observed",
        "touch_drag_observed",
        "hardware_keyboard_attached",
        "keyboard_press_release_observed",
        "keyboard_modifier_observed",
        "keyboard_modifier_release_no_leak_observed",
        "hover_pointer_accessory_attached",
        "hover_pointer_move_observed",
        "host_input_acknowledgements_retained",
        "ios_logs_retained",
        "host_logs_retained",
        "android_evidence_used_for_ios_input",
        "simulator_evidence_used_for_ios_input",
        "offline_tests_used_as_device_evidence"
      ],
      "properties": {
        "ios_device_lock_acquired": {"type": "boolean"},
        "device_identity_recorded": {"type": "boolean"},
        "device_is_iphone_or_ipad": {"type": "boolean"},
        "iphone_native_input_observed": {"type": "boolean"},
        "ipad_native_input_observed": {"type": "boolean"},
        "app_revision_recorded": {"type": "boolean"},
        "signed_app_installed": {"type": "boolean"},
        "local_network_permission_recorded": {"type": "boolean"},
        "baseline_machost_listener_observed": {"type": "boolean"},
        "protocol_session_negotiated": {"type": "boolean"},
        "input_capabilities_negotiated": {"type": "boolean"},
        "display_stream_binding_recorded": {"type": "boolean"},
        "touch_tap_observed": {"type": "boolean"},
        "touch_drag_observed": {"type": "boolean"},
        "hardware_keyboard_attached": {"type": "boolean"},
        "keyboard_press_release_observed": {"type": "boolean"},
        "keyboard_modifier_observed": {"type": "boolean"},
        "keyboard_modifier_release_no_leak_observed": {"type": "boolean"},
        "hover_pointer_accessory_attached": {"type": "boolean"},
        "hover_pointer_move_observed": {"type": "boolean"},
        "host_input_acknowledgements_retained": {"type": "boolean"},
        "ios_logs_retained": {"type": "boolean"},
        "host_logs_retained": {"type": "boolean"},
        "android_evidence_used_for_ios_input": {"type": "boolean"},
        "simulator_evidence_used_for_ios_input": {"type": "boolean"},
        "offline_tests_used_as_device_evidence": {"type": "boolean"}
      }
    },
    "missing_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "requirement"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1}
        }
      }
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "requirement"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1}
        }
      }
    },
    "disallowed_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blocking_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string"}
  }
}
