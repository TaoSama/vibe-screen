{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/summary.schema.json",
  "title": "Vibe Screen evidence summary v1",
  "type": "object",
  "required": ["schema_version", "run_id", "kind", "status"],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "run_id": {"type": "string"},
    "kind": {"enum": ["soak", "glass_to_glass", "input_latency", "telemetry_stage_latency", "reconnect"]},
    "status": {"enum": ["complete", "partial", "failed", "informational"]},
    "transport": {"enum": ["usb", "lan"]},
    "metrics": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
