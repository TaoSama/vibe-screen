{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-screen.dev/schemas/evidence/v1/harmony-avcodec-preflight.schema.json",
  "title": "Vibe Screen HarmonyOS AVCodec hardware decode preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "created_at",
    "repository",
    "toolchain",
    "artifact",
    "device",
    "host",
    "codecs",
    "blockers",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "vibescreen.evidence/v1"},
    "kind": {"const": "harmony_avcodec_hardware_decode_preflight"},
    "run_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "tree", "dirty", "status_porcelain"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "tree": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"},
        "status_porcelain": {"type": "array", "items": {"type": "string"}}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deveco_studio_version", "harmony_sdk_api", "harmony_sdk_version", "hvigor_version", "ohpm_version", "hdc_version"],
      "properties": {
        "deveco_studio_version": {"type": "string", "minLength": 1},
        "harmony_sdk_api": {"type": "string", "minLength": 1},
        "harmony_sdk_version": {"type": "string", "minLength": 1},
        "hvigor_version": {"type": "string", "minLength": 1},
        "ohpm_version": {"type": "string", "minLength": 1},
        "hdc_version": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_name", "version_name", "hap_sha256", "signature_certificate_sha256"],
      "properties": {
        "bundle_name": {"const": "dev.vibescreen.harmony"},
        "version_name": {"type": "string", "minLength": 1},
        "hap_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature_certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "manufacturer", "model", "product", "os_build", "hdc_target", "serial_hash"],
      "properties": {
        "platform": {"enum": ["HarmonyOS", "HarmonyOS NEXT"]},
        "manufacturer": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "os_build": {"type": "string", "minLength": 1},
        "hdc_target": {"type": "string", "minLength": 1},
        "serial_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "build_sha256", "protocol"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "build_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "protocol": {"const": "Protocol v1"}
      }
    },
    "codecs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codec", "status", "decoder_name", "gates", "media_header", "artifacts"],
        "properties": {
          "codec": {"enum": ["h264", "hevc"]},
          "status": {"enum": ["pass", "blocked", "fail"]},
          "decoder_name": {"type": "string", "minLength": 1},
          "gates": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decoder_capability",
              "hardware_decoder",
              "xcomponent_surface",
              "buffer_callback",
              "protocol_media_header",
              "pts_preserved",
              "input_buffer_pushed",
              "output_rendered",
              "output_buffer_freed",
              "flush_completed",
              "reconfigure_completed",
              "eos_completed",
              "release_completed"
            ],
            "properties": {
              "decoder_capability": {"enum": ["pass", "blocked", "fail"]},
              "hardware_decoder": {"enum": ["pass", "blocked", "fail"]},
              "xcomponent_surface": {"enum": ["pass", "blocked", "fail"]},
              "buffer_callback": {"enum": ["pass", "blocked", "fail"]},
              "protocol_media_header": {"enum": ["pass", "blocked", "fail"]},
              "pts_preserved": {"enum": ["pass", "blocked", "fail"]},
              "input_buffer_pushed": {"enum": ["pass", "blocked", "fail"]},
              "output_rendered": {"enum": ["pass", "blocked", "fail"]},
              "output_buffer_freed": {"enum": ["pass", "blocked", "fail"]},
              "flush_completed": {"enum": ["pass", "blocked", "fail"]},
              "reconfigure_completed": {"enum": ["pass", "blocked", "fail"]},
              "eos_completed": {"enum": ["pass", "blocked", "fail"]},
              "release_completed": {"enum": ["pass", "blocked", "fail"]}
            }
          },
          "media_header": {
            "type": "object",
            "additionalProperties": false,
            "required": ["codec", "stream_id", "session_epoch", "config_epoch", "first_frame_id", "fragment_index", "fragment_count", "payload_length"],
            "properties": {
              "codec": {"enum": ["h264", "hevc"]},
              "stream_id": {"type": "integer", "minimum": 1},
              "session_epoch": {"type": "integer", "minimum": 1},
              "config_epoch": {"type": "integer", "minimum": 1},
              "first_frame_id": {"type": "integer", "minimum": 1},
              "fragment_index": {"const": 0},
              "fragment_count": {"const": 1},
              "payload_length": {"type": "integer", "minimum": 1}
            }
          },
          "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tool_probe": {"type": "object"},
    "hdc_targets": {"type": ["string", "null"]},
    "hdc_error": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
