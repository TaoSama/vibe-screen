<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The dialog window already owns the outer safe-area margin. Keep the
         content padding compact enough for narrow phones. -->
    <dimen name="settings_content_padding">24dp</dimen>
    <dimen name="settings_content_padding_top">24dp</dimen>
    <dimen name="settings_content_padding_bottom">24dp</dimen>
    <dimen name="settings_dialog_max_width">680dp</dimen>
    <dimen name="settings_two_column_min_width">600dp</dimen>
    <dimen name="settings_column_gap">0dp</dimen>
    <dimen name="settings_header_margin_bottom">32dp</dimen>
    <dimen name="settings_section_padding">16dp</dimen>
    <dimen name="settings_section_margin_bottom">16dp</dimen>
    <dimen name="settings_inner_group_margin_top">16dp</dimen>

    <!-- Tap-to-reveal control bar geometry. Compact and centered, with
         icon buttons held at the 48dp accessibility minimum so the
         settings/disconnect targets are comfortable and hard to mis-tap. -->
    <dimen name="control_bar_margin_top">20dp</dimen>
    <!-- Cap the bar on wide displays; match constraints let it shrink to the
         current safe window width while preserving fixed action targets. -->
    <dimen name="control_bar_max_width">352dp</dimen>
    <dimen name="control_bar_corner_radius">18dp</dimen>
    <dimen name="control_bar_content_padding">6dp</dimen>
    <dimen name="control_bar_button_size">48dp</dimen>
    <dimen name="control_bar_button_icon_size">24dp</dimen>
    <dimen name="control_bar_button_margin">4dp</dimen>
    <dimen name="control_bar_column_button_margin">8dp</dimen>
    <!-- Extra separation before the destructive Disconnect button so it is
         not adjacent to the settings/display controls. -->
    <dimen name="control_bar_disconnect_margin_start">12dp</dimen>
    <dimen name="connection_status_min_width">72dp</dimen>
    <dimen name="connection_status_gap">6dp</dimen>

    <!-- Display-selection capsule presented as a tappable dropdown selector:
         a leading displays icon, the active display name, and a chevron. Sized
         so touch users read it as "tap to switch display" without inflating
         the resting control bar. -->
    <dimen name="display_capsule_min_height">48dp</dimen>
    <dimen name="display_capsule_min_width">88dp</dimen>
    <dimen name="display_capsule_horizontal_padding">8dp</dimen>
    <dimen name="display_capsule_icon_size">20dp</dimen>
    <dimen name="display_capsule_chevron_size">18dp</dimen>
    <dimen name="display_capsule_label_margin">6dp</dimen>
    <dimen name="display_capsule_corner_radius">12dp</dimen>

    <!-- Gap between the header and actions columns when the connection panel
         splits into two columns in landscape; ignored in the stacked layout. -->
    <dimen name="connection_panel_column_gap">28dp</dimen>
    <dimen name="connection_panel_padding_top">32dp</dimen>
    <dimen name="connection_panel_padding_bottom">28dp</dimen>
    <dimen name="connection_mode_margin_bottom">16dp</dimen>
    <dimen name="connection_section_margin">12dp</dimen>
    <dimen name="connection_icon_size">56dp</dimen>
    <dimen name="connection_icon_margin_bottom">12dp</dimen>
    <dimen name="connection_wordmark_margin_bottom">6dp</dimen>
    <dimen name="connection_title_margin_bottom">6dp</dimen>
    <dimen name="connection_subtitle_margin_bottom">12dp</dimen>
    <dimen name="connection_subtitle_touch_target_min_height">48dp</dimen>
    <dimen name="connection_subtitle_disclosure_icon_padding">4dp</dimen>
    <dimen name="connection_progress_margin_bottom">12dp</dimen>
    <dimen name="connection_primary_action_margin_top">12dp</dimen>

    <!-- Floating stats overlay. The overlay stacks into multiple rows on
         narrow windows so FPS/bitrate/resolution/RTT/link never extend past
         the safe display edge while streaming. -->
    <dimen name="status_overlay_content_padding">12dp</dimen>
    <dimen name="status_overlay_item_gap">16dp</dimen>
    <dimen name="status_overlay_row_gap">8dp</dimen>
    <dimen name="status_overlay_column_min_width">96dp</dimen>
</resources>
