<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tap-to-reveal control bar geometry. Compact and centered, with
         icon buttons held at the 48dp accessibility minimum so the
         settings/disconnect targets are comfortable and hard to mis-tap. -->
    <dimen name="control_bar_margin_top">20dp</dimen>
    <dimen name="control_bar_max_width">320dp</dimen>
    <dimen name="control_bar_corner_radius">18dp</dimen>
    <dimen name="control_bar_content_padding">6dp</dimen>
    <dimen name="control_bar_button_size">48dp</dimen>
    <dimen name="control_bar_button_icon_size">24dp</dimen>
    <dimen name="control_bar_button_margin">4dp</dimen>
    <!-- Extra separation before the destructive Disconnect button so it is
         not adjacent to the settings/display controls. -->
    <dimen name="control_bar_disconnect_margin_start">12dp</dimen>

    <!-- Display-selection capsule presented as a tappable dropdown selector:
         a leading displays icon, the active display name, and a chevron. Sized
         so touch users read it as "tap to switch display" without inflating
         the resting control bar. -->
    <dimen name="display_capsule_min_height">48dp</dimen>
    <dimen name="display_capsule_horizontal_padding">8dp</dimen>
    <dimen name="display_capsule_icon_size">20dp</dimen>
    <dimen name="display_capsule_chevron_size">18dp</dimen>
    <dimen name="display_capsule_label_margin">6dp</dimen>
    <dimen name="display_capsule_label_max_width">128dp</dimen>
    <dimen name="display_capsule_corner_radius">12dp</dimen>

    <!-- Gap between the header and actions columns when the connection panel
         splits into two columns in landscape; ignored in the stacked layout. -->
    <dimen name="connection_panel_column_gap">28dp</dimen>
    <dimen name="connection_panel_padding_top">32dp</dimen>
    <dimen name="connection_panel_padding_bottom">28dp</dimen>
    <dimen name="connection_mode_margin_bottom">16dp</dimen>
    <dimen name="connection_section_margin">12dp</dimen>
    <dimen name="connection_icon_size">72dp</dimen>
    <dimen name="connection_icon_margin_bottom">20dp</dimen>
    <dimen name="connection_wordmark_margin_bottom">10dp</dimen>
    <dimen name="connection_title_margin_bottom">8dp</dimen>
</resources>
