<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clipboardConfirmationScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="true"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="16dp"
    android:scrollIndicators="bottom">

    <LinearLayout
        android:id="@+id/clipboardConfirmationContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clipboardConfirmationIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="simple"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/clipboardConfirmationDirectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:labelFor="@id/clipboardConfirmationDirection"
            android:text="@string/clipboard_confirmation_direction_label"
            android:textColor="?attr/colorOnSurface"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clipboardConfirmationDirection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:breakStrategy="simple"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/clipboardConfirmationProtectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:labelFor="@id/clipboardConfirmationProtection"
            android:text="@string/clipboard_confirmation_protection_label"
            android:textColor="?attr/colorOnSurface"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clipboardConfirmationProtection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:breakStrategy="simple"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/clipboardConfirmationSizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:labelFor="@id/clipboardConfirmationSize"
            android:text="@string/clipboard_confirmation_size_label"
            android:textColor="?attr/colorOnSurface"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clipboardConfirmationSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:breakStrategy="simple"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/clipboardConfirmationPreviewLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:labelFor="@id/clipboardConfirmationPreview"
            android:text="@string/clipboard_confirmation_preview_label"
            android:textColor="?attr/colorOnSurface"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clipboardConfirmationPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/dialog_field_bg"
            android:breakStrategy="simple"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:scrollHorizontally="false"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/clipboardConfirmationNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:breakStrategy="simple"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
