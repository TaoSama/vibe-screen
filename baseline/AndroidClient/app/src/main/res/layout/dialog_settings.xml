<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardBackgroundColor="#E6000000"
    app:cardElevation="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:fadeScrollbars="true"
        android:scrollIndicators="bottom"
        android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/settingsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/settings_content_padding">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/display_settings"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Show Stats Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/settings_item_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_stats"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_description"
                    android:textColor="#999999"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/showStatsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:contentDescription="@string/show_stats"
                app:thumbTint="@color/switch_thumb_color"
                app:trackTint="@color/switch_track_color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/deviceHealthSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/settings_item_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_health_title"
                android:textColor="@color/on_surface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deviceHealthStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/device_health_checking"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deviceHealthSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/device_health_summary_unknown"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/settings_item_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/viewport"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/displayCapability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:textColor="#A8B0B6"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scaleFitButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/scale_fit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scaleFillButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/scale_fill" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/rotationGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/rotation_description"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rotationFollow"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/rotation_follow_host" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rotation90"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/rotation_90" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rotation180"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/rotation_180" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rotation270"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/rotation_270" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/input_capability_touch_only"
                android:textColor="#FFCC80"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Video Section -->
        <LinearLayout
            android:id="@+id/videoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_item_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_section_title"
                android:textColor="@color/on_surface"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_quality_label"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/videoQualityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/videoQualityAuto"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/video_quality_auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/videoQualitySmooth"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/video_quality_smooth" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/videoQualityBalanced"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/video_quality_balanced" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/videoQualitySharp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="@string/video_quality_sharp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_frame_rate_label"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/videoFrameRateGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/videoFps30"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/video_frame_rate_30" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/videoFps60"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/video_frame_rate_60" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/videoFps120"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/video_frame_rate_120" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/video_bitrate_label"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/videoBitrateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/videoBitrateSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/video_bitrate_label"
                android:valueFrom="1.0"
                android:valueTo="100.0"
                android:value="20.0"
                android:stepSize="1.0"
                app:thumbColor="@color/on_surface"
                app:trackColorActive="@color/accent"
                app:trackColorInactive="@color/hairline"
                app:trackHeight="4dp" />

            <TextView
                android:id="@+id/videoControlUnavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/video_control_unavailable"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Gesture Shortcuts Section -->
        <LinearLayout
            android:id="@+id/gestureShortcutSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_item_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gesture_shortcuts_title"
                android:textColor="@color/on_surface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="@string/gesture_shortcuts_description"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gesture_swipe_up_label"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/gestureSwipeUpGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gestureSwipeUpDefault"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/gesture_action_default" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gestureSwipeUpMoveWindow"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/gesture_action_move_window" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gestureSwipeUpReturnWindows"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/gesture_action_return_windows" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gesture_swipe_down_label"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/gestureSwipeDownGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gestureSwipeDownDefault"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/gesture_action_default" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gestureSwipeDownMoveWindow"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/gesture_action_move_window" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gestureSwipeDownReturnWindows"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/gesture_action_return_windows" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/gestureShortcutUnavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/gesture_shortcuts_unavailable"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Opacity Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_item_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/opacityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/opacitySlider"
                android:text="@string/overlay_opacity"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/opacityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opacity_default"
                android:textColor="#4CAF50"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/opacitySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0.2"
                android:valueTo="1.0"
                android:value="0.8"
                android:stepSize="0.05"
                app:thumbColor="#FFFFFF"
                app:trackColorActive="#4CAF50"
                app:trackColorInactive="#33FFFFFF"
                app:trackHeight="4dp" />
        </LinearLayout>

        <!-- Settings Button Position - 8 directions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_item_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_button_position"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- 8 Position Grid (3x3 without center) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Top Row: TopLeft, TopCenter, TopRight -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cornerTopLeft"
                        style="@style/SettingsPositionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:text="@string/position_top_left"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginEnd="3dp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#4CAF50"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/positionTopCenter"
                        style="@style/SettingsPositionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:text="@string/position_top"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#4CAF50"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cornerTopRight"
                        style="@style/SettingsPositionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:text="@string/position_top_right"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginStart="3dp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#4CAF50"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Middle Row: Left, (empty center), Right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/positionCenterLeft"
                        style="@style/SettingsPositionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:text="@string/position_left"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginEnd="3dp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#4CAF50"
                        app:strokeWidth="1dp" />

                    <!-- Empty center space -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/positionCenterRight"
                        style="@style/SettingsPositionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:text="@string/position_right"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginStart="3dp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#4CAF50"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Bottom Row: BottomLeft, BottomCenter, BottomRight -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cornerBottomLeft"
                        style="@style/SettingsPositionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:text="@string/position_bottom_left"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginEnd="3dp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#4CAF50"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/positionBottomCenter"
                        style="@style/SettingsPositionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:text="@string/position_bottom"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#4CAF50"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cornerBottomRight"
                        style="@style/SettingsPositionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:text="@string/position_bottom_right"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginStart="3dp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#4CAF50"
                        app:strokeWidth="1dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons Row 1 -->
        <LinearLayout
            android:id="@+id/settingsResetActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center">

            <!-- Reset Overlay Position Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetPositionButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:ellipsize="none"
                android:maxLines="2"
                android:text="@string/reset_overlay"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                app:cornerRadius="14dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp"
                app:backgroundTint="#1AFFFFFF" />

            <!-- Reset Settings Button Position -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetSettingsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:ellipsize="none"
                android:maxLines="2"
                android:text="@string/reset_button"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                app:cornerRadius="14dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp"
                app:backgroundTint="#1AFFFFFF" />
        </LinearLayout>

        <!-- Disconnect Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/disconnectSettingsButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/disconnect"
            android:textColor="#F44336"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            app:cornerRadius="14dp"
            app:strokeColor="#F44336"
            app:strokeWidth="1dp"
            app:backgroundTint="#1AF44336" />

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/done"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:cornerRadius="16dp"
            app:backgroundTint="#4CAF50" />

    </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
