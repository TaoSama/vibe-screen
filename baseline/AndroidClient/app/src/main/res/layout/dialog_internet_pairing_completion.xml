<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/internetPairingDialogScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="true"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="16dp"
    android:scrollIndicators="bottom">

    <LinearLayout
        android:id="@+id/internetPairingDialogContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/internetPairingIdentityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:breakStrategy="simple"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/internetPairingRequestLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:labelFor="@id/internetPairingRequestText"
            android:text="@string/internet_pairing_request_label"
            android:textColor="?attr/colorOnSurface"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/internetPairingRequestText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/dialog_field_bg"
            android:breakStrategy="simple"
            android:minHeight="88dp"
            android:padding="12dp"
            android:scrollHorizontally="false"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/internetPairingAcceptanceLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:labelFor="@id/internetPairingAcceptanceInput"
            android:text="@string/internet_pairing_acceptance_label"
            android:textColor="?attr/colorOnSurface"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/internetPairingAcceptanceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top|start"
            android:hint="@string/internet_pairing_acceptance_hint"
            android:importantForAutofill="noExcludeDescendants"
            android:imeOptions="flagNoExtractUi|flagNoPersonalizedLearning"
            android:inputType="textMultiLine"
            android:breakStrategy="simple"
            android:minHeight="128dp"
            android:minLines="4"
            android:overScrollMode="ifContentScrolls"
            android:saveEnabled="false"
            android:scrollHorizontally="false"
            android:singleLine="false"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
