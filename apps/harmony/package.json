{
  "name": "@vibescreen/harmony-client-tests",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "clean": "rm -rf .test-dist",
    "static": "node scripts/validate-project.mjs",
    "test:static": "node --test tests/validate-project.test.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "verify": "pnpm run clean && pnpm run static && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "json5": "2.2.3",
    "typescript": "5.9.3"
  }
}
